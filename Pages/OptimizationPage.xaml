<Page
    x:Class="AutoPortal.Pages.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
            <TextBlock 
                Text="优化" 
                Style="{StaticResource TitleLargeTextBlockStyle}"
                FontWeight="Bold"/>
            <TextBlock 
                Text="解放设备，优化使用体验" 
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- 极域助手卡片 -->
                <Border
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7A8;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="极域助手" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="极域电子教室管理工具" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            
                            <Grid ColumnSpacing="12" RowSpacing="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="未启用" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            
                            <Button Content="敬请期待" HorizontalAlignment="Stretch" Height="44" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 系统助手卡片 -->
                <Border
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="系统助手" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="系统信息查看工具" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            
                            <Grid ColumnSpacing="12" RowSpacing="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="系统版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="待检测" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            
                            <Button Content="敬请期待" HorizontalAlignment="Stretch" Height="44" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 校园网助手卡片 -->
                <Border
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="校园网助手" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="校园网连接管理工具" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            
                            <Grid ColumnSpacing="12" RowSpacing="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="网络状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="待检测" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="代理" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="未配置" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            
                            <Button Content="敬请期待" HorizontalAlignment="Stretch" Height="44" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 未完待续卡片 -->
                <Border
                    Padding="40"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon 
                            Glyph="&#xE7A8;" 
                            FontSize="64"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock 
                                Text="未完待续" 
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                FontWeight="SemiBold"
                                FontSize="24"
                                HorizontalAlignment="Center"/>
                            
                            <TextBlock 
                                Text="更多功能正在制作中，敬请期待..." 
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <ProgressRing 
                            IsActive="True"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
