<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoPortal.Pages.NetworkCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="网络诊断" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="检测网络连接状态并诊断问题" FontSize="14" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="StartButton" Grid.Column="1" Content="开始检测" Padding="28,12" FontSize="14" FontWeight="SemiBold" Click="StartButton_Click" Height="50" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Padding="28,12" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" Click="CancelButton_Click" Height="50" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" Spacing="12"/>
        </ScrollViewer>
    </Grid>
</Page>
